{
  "name": "farescope",
  "version": "0.1.0",
  "description": "Personal flight price search: live Google Flights fares, fare calendar, every seller compared, honest totals",
  "main": "server/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node scripts/dev.mjs",
    "demo": "DEMO=1 node --disable-warning=ExperimentalWarning server/index.js",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && VITE_STATIC=1 vite build",
    "preview": "npx --yes serve@14.2.4 dist",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "express": "^4.21.2",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
