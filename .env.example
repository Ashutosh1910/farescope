# Live prices (Google Flights via SerpApi). Free plan: 250 searches/month. https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Cached cheap-date prices (Travelpayouts / Aviasales Data API). https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# Optional
PORT=3000
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_HOURLY_LIMIT=50
# How long a live search result is reused before spending another SerpApi call
LIVE_CACHE_MINUTES=180
CALENDAR_CACHE_MINUTES=720
SERPAPI_GL=in
# DEMO=1 forces synthetic data even when keys are set
